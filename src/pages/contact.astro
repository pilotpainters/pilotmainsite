---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/layout/Container.astro';
import Card from '@/components/ui/Card.astro';
import CTABand from '@/components/ui/CTABand.astro';
import { Icon } from 'astro-icon/components';
import { getEntry } from 'astro:content';
import { withBase } from '@/lib/url';
import { siteConfig } from '@config/site.config';

const pageEntry = await getEntry('pages', 'contact');
if (!pageEntry?.data.contact) {
  throw new Error('Missing content entry: content/pages/contact.md with contact frontmatter.');
}
const contact = pageEntry.data.contact;

const contactPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: contact.seo.title,
  description: contact.seo.description,
  url: new URL(withBase('/contact/'), siteConfig.seo.siteUrl).href,
  mainEntity: { '@id': `${siteConfig.seo.siteUrl}#business` },
};
---

<BaseLayout
  title={contact.seo.title}
  description={contact.seo.description}
  image={contact.seo.ogImage}
  jsonLd={[contactPageJsonLd]}
>
  <main class="flex-1">
    <Section
      id="contact-hero"
      tone="white"
      spacing="sm"
      containerSize={null}
      class="bg-gradient-to-br from-brand-black to-primary-dark relative overflow-hidden text-brand-white"
      labelledby="contact-hero-heading"
    >
      <Container size="lg">
        <div class="mx-auto max-w-3xl py-4 text-center">
          {contact.hero.eyebrow && (
            <p class="text-caption uppercase tracking-wide text-primary-light">{contact.hero.eyebrow}</p>
          )}
          <h1 id="contact-hero-heading" class="mt-4 text-h1 text-brand-white">
            {contact.hero.headline}
          </h1>
          <p class="mt-4 text-body text-neutral-100/90">{contact.hero.subheadline}</p>
        </div>
      </Container>
    </Section>

    <Section id="contact-main" tone="neutral" spacing="md" labelledby="contact-info-heading">
      <Container size="lg">
        <div class="mx-auto max-w-2xl text-center">
          <h2 id="contact-info-heading" class="text-h2 text-neutral-900">{contact.info.heading}</h2>
          <p class="mt-3 text-body text-neutral-700">{contact.info.subheading}</p>
        </div>

        <div class="mx-auto mt-10 grid max-w-3xl gap-6 sm:grid-cols-2">
          <Card variant="outlined" padding="lg" class="bg-brand-white">
            <div class="flex flex-col items-center text-center">
              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-brand-white">
                <Icon name="lucide:phone" class="h-7 w-7" aria-hidden="true" />
              </div>
              <p class="mt-5 text-small font-medium text-neutral-900">{contact.info.phoneLabel}</p>
              <a
                href={`tel:${siteConfig.phoneTel}`}
                class="mt-2 text-h4 text-primary hover:text-primary-dark"
              >
                {siteConfig.phone}
              </a>
            </div>
          </Card>

          <Card variant="outlined" padding="lg" class="bg-brand-white">
            <div class="flex flex-col items-center text-center">
              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-brand-white">
                <Icon name="lucide:mail" class="h-7 w-7" aria-hidden="true" />
              </div>
              <p class="mt-5 text-small font-medium text-neutral-900">{contact.info.emailLabel}</p>
              <a
                href={`mailto:${siteConfig.email}`}
                class="mt-2 break-all text-h4 text-primary hover:text-primary-dark"
              >
                {siteConfig.email}
              </a>
            </div>
          </Card>
        </div>

        <p class="mx-auto mt-10 flex max-w-xl items-center justify-center gap-2 text-center text-small text-neutral-500">
          <Icon name="lucide:clock" class="h-4 w-4 shrink-0" aria-hidden="true" />
          {contact.info.responseNote}
        </p>
      </Container>
    </Section>

    {contact.cta && (
      <CTABand
        id="cta"
        tone={contact.cta.tone}
        headline={contact.cta.heading}
        subheading={contact.cta.subheading}
        primaryCta={contact.cta.primaryCta}
        callCtaLabel={contact.cta.callCtaLabel}
        ariaLabelledby="contact-cta-heading"
      />
    )}
  </main>
</BaseLayout>
