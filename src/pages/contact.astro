---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/layout/Container.astro';
import Card from '@/components/ui/Card.astro';
import CTABand from '@/components/ui/CTABand.astro';
import FormField from '@/components/ui/FormField.astro';
import { Icon } from 'astro-icon/components';
import { getEntry, getCollection } from 'astro:content';
import { withBase } from '@/lib/url';
import { siteConfig } from '@config/site.config';

const pageEntry = await getEntry('pages', 'contact');
if (!pageEntry?.data.contact) {
  throw new Error('Missing content entry: content/pages/contact.md with contact frontmatter.');
}
const contact = pageEntry.data.contact;

const allServices = (await getCollection('services'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const contactPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: contact.seo.title,
  description: contact.seo.description,
  url: new URL(withBase('/contact/'), siteConfig.seo.siteUrl).href,
  mainEntity: { '@id': `${siteConfig.seo.siteUrl}#business` },
};
---

<BaseLayout
  title={contact.seo.title}
  description={contact.seo.description}
  image={contact.seo.ogImage}
  jsonLd={[contactPageJsonLd]}
>
  <main class="flex-1">
    {/* Hero — compact vertical padding for transactional page */}
    <Section
      id="contact-hero"
      tone="white"
      spacing="sm"
      containerSize={null}
      class="bg-gradient-to-br from-brand-black to-primary-dark relative overflow-hidden text-brand-white"
      labelledby="contact-hero-heading"
    >
      <Container size="lg">
        <div class="max-w-3xl py-4">
          {contact.hero.eyebrow && (
            <p class="text-caption uppercase tracking-wide text-primary-light">{contact.hero.eyebrow}</p>
          )}
          <h1 id="contact-hero-heading" class="mt-4 text-h1 text-brand-white">
            {contact.hero.headline}
          </h1>
          <p class="mt-4 text-body text-neutral-100/90">{contact.hero.subheadline}</p>
        </div>
      </Container>
    </Section>

    {/* Main contact section */}
    <Section id="contact-main" tone="neutral" spacing="md" labelledby="contact-info-heading">
      <Container size="lg">
        <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">
          {/* Left column — contact info */}
          <div>
            <h2 id="contact-info-heading" class="text-h2 text-neutral-900">{contact.info.heading}</h2>
            <p class="mt-3 text-body text-neutral-700">{contact.info.subheading}</p>

            <div class="mt-10 space-y-8">
              {/* Phone */}
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-brand-white">
                  <Icon name="lucide:phone" class="h-6 w-6" aria-hidden="true" />
                </div>
                <div>
                  <p class="text-small font-medium text-neutral-900">{contact.info.phoneLabel}</p>
                  <a
                    href={`tel:${siteConfig.phoneTel}`}
                    class="mt-1 block text-h5 text-primary hover:text-primary-dark"
                  >
                    {siteConfig.phone}
                  </a>
                </div>
              </div>

              {/* Email */}
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-brand-white">
                  <Icon name="lucide:mail" class="h-6 w-6" aria-hidden="true" />
                </div>
                <div>
                  <p class="text-small font-medium text-neutral-900">{contact.info.emailLabel}</p>
                  <a
                    href={`mailto:${siteConfig.email}`}
                    class="mt-1 block text-h5 text-primary hover:text-primary-dark break-all"
                  >
                    {siteConfig.email}
                  </a>
                </div>
              </div>
            </div>

            {/* Response note */}
            <div class="mt-10 flex items-start gap-2 text-small text-neutral-500">
              <Icon name="lucide:clock" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
              <p>{contact.info.responseNote}</p>
            </div>
          </div>

          {/* Right column — form */}
          <div>
            <Card variant="elevated" padding="lg">
              <h2 id="contact-form-heading" class="text-h2 text-neutral-900">{contact.form.heading}</h2>
              <p class="mt-2 text-body text-neutral-700">{contact.form.subheading}</p>

              <!--
                FORM HANDLER PLACEHOLDER
                To wire up form submissions:
                1. Sign up for a form handler (e.g. Formspree at formspree.io or Web3Forms at web3forms.com)
                2. Replace the action attribute below with the form endpoint URL provided by the service
                3. For Web3Forms specifically, also add a hidden input: <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY">
                4. Test end-to-end submission before deploying
                5. Remove this comment when wired up
              -->
              <form
                action="REPLACE_WITH_FORM_HANDLER_URL"
                method="POST"
                class="mt-8 space-y-6"
              >
                <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <input type="hidden" name="_subject" value="New Pilot Painters Quote Request" />

                <FormField
                  fieldType="input"
                  type="text"
                  name="full_name"
                  id="full_name"
                  label={contact.form.fields.name.label}
                  placeholder={contact.form.fields.name.placeholder}
                  required={contact.form.fields.name.required}
                />

                <div class="grid gap-6 md:grid-cols-2">
                  <FormField
                    fieldType="input"
                    type="email"
                    name="email"
                    id="email"
                    label={contact.form.fields.email.label}
                    placeholder={contact.form.fields.email.placeholder}
                    required={contact.form.fields.email.required}
                  />

                  <FormField
                    fieldType="input"
                    type="tel"
                    name="phone"
                    id="phone"
                    label={contact.form.fields.phone.label}
                    placeholder={contact.form.fields.phone.placeholder}
                    required={contact.form.fields.phone.required}
                    pattern={'[\\d\\s\\-\\(\\)\\+]{7,15}'}
                  />
                </div>

                <FormField
                  fieldType="select"
                  name="service"
                  id="service"
                  label={contact.form.fields.service.label}
                  required={contact.form.fields.service.required}
                >
                  <option value="" disabled selected hidden>{contact.form.fields.service.placeholder}</option>
                  {allServices.map((s) => (
                    <option value={s.data.slug}>{s.data.title}</option>
                  ))}
                  <option value="multiple">Multiple services</option>
                  <option value="not-sure">Not sure yet</option>
                </FormField>

                <FormField
                  fieldType="input"
                  type="text"
                  name="address"
                  id="address"
                  label={contact.form.fields.address.label}
                  placeholder={contact.form.fields.address.placeholder}
                  required={contact.form.fields.address.required}
                  helpText={contact.form.fields.address.helpText}
                />

                <FormField
                  fieldType="textarea"
                  name="message"
                  id="message"
                  label={contact.form.fields.message.label}
                  placeholder={contact.form.fields.message.placeholder}
                  required={contact.form.fields.message.required}
                  rows={contact.form.fields.message.rows}
                />

                <div>
                  <button
                    type="submit"
                    class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-accent px-6 py-3 text-h6 font-semibold text-brand-white transition-colors duration-150 hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-white sm:w-auto"
                  >
                    <Icon name="lucide:send" class="h-5 w-5" aria-hidden="true" />
                    {contact.form.submitLabel}
                  </button>
                </div>

                {contact.form.privacyNote && (
                  <p class="text-caption text-neutral-500">
                    {contact.form.privacyNote}{' '}
                    <a href={withBase('/privacy/')} class="text-primary underline hover:text-primary-dark">
                      Privacy Policy
                    </a>
                  </p>
                )}
              </form>
            </Card>
          </div>
        </div>
      </Container>
    </Section>

    {/* Optional CTA band — only rendered if cta frontmatter is populated */}
    {contact.cta && (
      <CTABand
        id="cta"
        tone={contact.cta.tone}
        headline={contact.cta.heading}
        subheading={contact.cta.subheading}
        primaryCta={contact.cta.primaryCta}
        callCtaLabel={contact.cta.callCtaLabel}
        ariaLabelledby="contact-cta-heading"
      />
    )}
  </main>
</BaseLayout>
