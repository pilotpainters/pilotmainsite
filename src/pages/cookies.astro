---
import LegalPageLayout from '@/components/layout/LegalPageLayout.astro';
import { getEntry } from 'astro:content';

const pageEntry = await getEntry('pages', 'cookies');
if (!pageEntry?.data.legal) {
  throw new Error('Missing content entry: content/pages/cookies.md with legal frontmatter.');
}
---

<LegalPageLayout legal={pageEntry.data.legal} />
