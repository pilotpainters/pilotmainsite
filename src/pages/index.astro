---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/layout/Container.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import CTABand from '@/components/ui/CTABand.astro';
import StarRating from '@/components/ui/StarRating.astro';
import { Icon } from 'astro-icon/components';
import { getEntry, getCollection } from 'astro:content';
import { withBase } from '@/lib/url';
import { resolvePublicImage } from '@/lib/images';
import { siteConfig } from '@config/site.config';
import { computeAggregateRating } from '@/lib/reviews';

const homeEntry = await getEntry('pages', 'home');
if (!homeEntry) throw new Error('Missing content entry: content/pages/home.md');
const home = homeEntry.data.home;
if (!home) throw new Error('Home page data missing from pages collection entry.');

const services = (await getCollection('services')).filter((s) => !s.data.draft);
services.sort((a, b) => {
  const af = a.data.featured === true ? 0 : 1;
  const bf = b.data.featured === true ? 0 : 1;
  if (af !== bf) return af - bf;
  return (a.data.order ?? 999) - (b.data.order ?? 999);
});

const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
const featuredProjects = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.completedDate.getTime() - a.data.completedDate.getTime());
const nonFeaturedProjects = projects.filter((p) => !p.data.featured);
const projectsToShow = [...featuredProjects, ...nonFeaturedProjects].slice(0, 3);

const serviceTypeLabels: Record<string, string> = {
  'interior-painting': 'Interior Painting',
  'exterior-painting': 'Exterior Painting',
  'cabinet-refinishing': 'Cabinet Refinishing',
  'commercial-painting': 'Commercial Painting',
};

const testimonials = (await getCollection('testimonials')).filter((t) => !t.data.draft);
const featuredTestimonial = testimonials.find((t) => t.data.featured) ?? testimonials[0];

const { average: computedAvg, count: computedCount } = computeAggregateRating(testimonials);
const showRating = computedCount >= 5;

const yearsInBusiness = new Date().getFullYear() - siteConfig.foundedYear;

const heroBg = home.hero.background;

const gradientDirectionMap: Record<string, string> = {
  t: 'bg-gradient-to-t',
  tr: 'bg-gradient-to-tr',
  r: 'bg-gradient-to-r',
  br: 'bg-gradient-to-br',
  b: 'bg-gradient-to-b',
  bl: 'bg-gradient-to-bl',
  l: 'bg-gradient-to-l',
  tl: 'bg-gradient-to-tl',
};
const heroGradientDirection = heroBg.type === 'gradient' ? heroBg.direction ?? 'br' : 'br';

const heroBgClasses: string[] = [];
if (heroBg.type === 'solid') {
  heroBgClasses.push(`bg-${heroBg.color}`);
} else if (heroBg.type === 'gradient') {
  heroBgClasses.push(gradientDirectionMap[heroGradientDirection] ?? gradientDirectionMap.br);
  heroBgClasses.push(`from-${heroBg.from}`);
  heroBgClasses.push(`to-${heroBg.to}`);
} else {
  heroBgClasses.push('bg-brand-black');
}

const heroImageSrc =
  heroBg.type === 'image' ? resolvePublicImage(heroBg.src, 'project') : undefined;
const shouldPreloadHeroImage = heroBg.type === 'image' && Boolean(heroImageSrc);

const localBusinessExtensionJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteConfig.seo.siteUrl}#business`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${siteConfig.company} Services`,
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.data.title,
        description: s.data.summary,
        areaServed: siteConfig.serviceAreas,
      },
      url: new URL(withBase(`/services/${s.data.slug ?? s.slug}/`), siteConfig.seo.siteUrl).toString(),
    })),
  },
};

if (showRating) {
  localBusinessExtensionJsonLd.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: computedAvg,
    reviewCount: computedCount,
  };
}

const extraJsonLd = [localBusinessExtensionJsonLd];
---

<BaseLayout
  title={home.seo.title}
  description={home.seo.description}
  image={home.seo.image}
  canonical={home.seo.canonical}
  jsonLd={extraJsonLd}
>
  {shouldPreloadHeroImage && (
    <Fragment slot="head">
      <link rel="preload" as="image" href={withBase(heroImageSrc!)} />
    </Fragment>
  )}

  <main class="flex-1">
    <!-- Hero -->
    <Section
      id="hero"
      tone="white"
      spacing="lg"
      containerSize={null}
      class:list={[
        heroBg.type === 'image' ? '!bg-transparent' : heroBgClasses,
        'relative overflow-hidden',
        'text-brand-white',
      ]}
    >
      {heroBg.type === 'image' && heroImageSrc && (
        <div class="absolute inset-0 z-0" aria-hidden="true">
          <img
            src={withBase(heroImageSrc)}
            alt={heroBg.alt}
            width="1600"
            height="900"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute inset-0 bg-neutral-900/75" />
        </div>
      )}

      <Container size="lg" class="relative z-10">
        <div class="max-w-3xl">
          <p class="text-caption uppercase tracking-wide text-neutral-100/90">{home.hero.eyebrow}</p>
          <h1 class="mt-4 text-h1 text-brand-white">{home.hero.headline}</h1>
          <p class="mt-6 text-body text-neutral-100/90">{home.hero.subheadline}</p>

          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
            <Button href={withBase(home.hero.primaryCta.href)} variant="accent" size="lg">
              {home.hero.primaryCta.label}
            </Button>
            <Button href={withBase(home.hero.secondaryCta.href)} variant="secondary" size="lg">
              {home.hero.secondaryCta.label}
            </Button>
          </div>

          <div class="mt-8 flex flex-col gap-3 text-small text-neutral-100/90 sm:flex-row sm:items-center sm:gap-6">
            <div class="flex items-center gap-2">
              <Icon name="lucide:shield-check" class="h-5 w-5 text-primary-light" aria-hidden="true" />
              <span>{home.hero.trustLine}</span>
            </div>

            {showRating && (
              <div class="flex items-center gap-2">
                <StarRating
                  rating={computedAvg}
                  size="sm"
                  emptyClass="fill-neutral-100/40"
                  filledClass="fill-accent"
                />
                <span class="text-neutral-100/90">{computedAvg} average ({computedCount} reviews)</span>
                <a
                  href={withBase(home.hero.rating.readMoreHref)}
                  class="text-primary-light underline underline-offset-4 hover:text-brand-white"
                >
                  {home.hero.rating.readMoreLabel}
                </a>
              </div>
            )}
          </div>
        </div>
      </Container>
    </Section>

    <!-- Trust Strip -->
    <Section
      id="trust"
      tone={home.trustStrip.tone}
      spacing="sm"
      containerSize={null}
      class="border-b border-neutral-100"
      aria-labelledby="trustHeading"
    >
      <Container size="lg">
        <h2 id="trustHeading" class="sr-only">
          {home.trustStrip.items.map((i) => i.label).join(', ')}
        </h2>
        <div class="card-grid card-grid-2-4-tight gap-4">
          {home.trustStrip.items.map((item) => (
            <Card variant="outlined" padding="md" class="bg-brand-white">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-md bg-primary-dark text-brand-white">
                  <Icon name={`lucide:${item.icon}`} class="h-5 w-5" aria-hidden="true" />
                </div>
                <div>
                  <p class="text-h5 text-neutral-900">{item.value}</p>
                  <p class="text-small text-neutral-700">{item.label}</p>
                </div>
              </div>
            </Card>
          ))}
        </div>
      </Container>
    </Section>

    <!-- Services -->
    <Section id="services" tone="white" spacing="md" aria-labelledby="servicesHeading">
      <Container size="lg">
        <div class="mx-auto max-w-2xl text-center">
          <h2 id="servicesHeading" class="text-h2 text-neutral-900">
            {home.servicesOverview.heading}
          </h2>
          <p class="mt-4 text-body text-neutral-700">{home.servicesOverview.lead}</p>
        </div>

        <div class="card-grid card-grid-2-4 mt-10">
          {services.slice(0, 4).map((service) => {
            const slug = service.data.slug ?? service.slug;
            const href = withBase(`/services/${slug}/`);
            const imageSrc = resolvePublicImage(service.data.image, 'service');
            return (
              <a href={href} class="group block h-full focus-visible:ring-2 focus-visible:ring-primary rounded-lg">
                <Card variant="outlined" padding="none" class="flex h-full flex-col overflow-hidden">
                  <div class="aspect-[16/9] w-full shrink-0 overflow-hidden bg-neutral-50">
                    <img
                      src={withBase(imageSrc)}
                      alt=""
                      width="640"
                      height="360"
                      class="h-full w-full object-cover object-center"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="flex flex-1 flex-col p-6">
                    <div class="flex items-center gap-2">
                      <Icon
                        name={`lucide:${service.data.icon}`}
                        class="h-5 w-5 text-primary"
                        aria-hidden="true"
                      />
                      <p class="text-h6 text-neutral-900 group-hover:text-primary">{service.data.title}</p>
                    </div>
                    <p class="mt-3 flex-1 text-small text-neutral-700">{service.data.summary}</p>
                    <div class="mt-5 inline-flex items-center gap-2 text-small text-primary">
                      <span class="underline underline-offset-4">{home.servicesOverview.learnMoreLabel}</span>
                      <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
                    </div>
                  </div>
                </Card>
              </a>
            );
          })}
        </div>
      </Container>
    </Section>

    <!-- Process -->
    <Section id="process" tone="neutral" spacing="md" aria-labelledby="processHeading">
      <Container size="lg">
        <div class="mx-auto max-w-2xl text-center">
          <h2 id="processHeading" class="text-h2 text-neutral-900">
            {home.process.heading}
          </h2>
          <p class="mt-4 text-body text-neutral-700">{home.process.lead}</p>
        </div>

        <div class="mt-10">
          <div class="card-grid card-grid-4-md">
            {home.process.steps.map((step, idx) => (
              <Card variant="outlined" padding="md" class="relative">
                {idx < home.process.steps.length - 1 && (
                  <div class="hidden md:block absolute right-0 top-7 h-px w-8 bg-neutral-300 translate-x-1/2" aria-hidden="true" />
                )}
                <div class="flex items-start gap-4 md:flex-col md:gap-3">
                  <div class="flex items-center gap-3 md:w-full">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-dark text-brand-white">
                      <span class="text-small">{idx + 1}</span>
                    </div>
                    <div class="flex h-10 w-10 items-center justify-center rounded-md bg-neutral-50 text-primary">
                      <Icon name={`lucide:${step.icon}`} class="h-5 w-5" aria-hidden="true" />
                    </div>
                  </div>
                  <div>
                    <p class="text-h6 text-neutral-900">{step.title}</p>
                    <p class="mt-2 text-small text-neutral-700">{step.description}</p>
                  </div>
                </div>
              </Card>
            ))}
          </div>
        </div>
      </Container>
    </Section>

    <!-- Featured Projects -->
    <Section id="projects" tone="white" spacing="md" aria-labelledby="projectsHeading">
      <Container size="lg">
        <div class="mx-auto max-w-2xl text-center">
          <h2 id="projectsHeading" class="text-h2 text-neutral-900">
            {home.featuredProjects.heading}
          </h2>
          <p class="mt-4 text-body text-neutral-700">{home.featuredProjects.lead}</p>
        </div>

        <div class="card-grid card-grid-3 mt-10">
          {projectsToShow.map((project) => {
            const imageSrc = resolvePublicImage(project.data.coverImage, 'project');
            const typeLabel = serviceTypeLabels[project.data.serviceType] ?? project.data.serviceType;
            const href = withBase(`/projects/${project.data.slug}/`);
            return (
              <a href={href} class="group block h-full focus-visible:ring-2 focus-visible:ring-primary rounded-lg">
                <Card variant="outlined" padding="none" class="flex h-full flex-col overflow-hidden">
                  <div class="aspect-[16/9] w-full shrink-0 overflow-hidden bg-neutral-50">
                    <img
                      src={withBase(imageSrc)}
                      alt=""
                      width="640"
                      height="360"
                      class="h-full w-full object-cover object-center"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="p-6">
                    <p class="text-h6 text-neutral-900 group-hover:text-primary">{project.data.title}</p>
                    <div class="mt-3 flex flex-wrap items-center gap-3 text-small text-neutral-700">
                      <span class="inline-flex items-center gap-2">
                        <Icon name="lucide:map-pin" class="h-4 w-4 text-primary" aria-hidden="true" />
                        {project.data.location}
                      </span>
                      <span class="inline-flex items-center rounded-full bg-neutral-50 px-3 py-1 text-caption text-neutral-700">
                        {home.featuredProjects.typeTagLabel}: {typeLabel}
                      </span>
                    </div>
                  </div>
                </Card>
              </a>
            );
          })}
        </div>

        <div class="mt-10 text-center">
          <Button href={withBase(home.featuredProjects.viewAllHref)} variant="primary" size="md">
            {home.featuredProjects.viewAllLabel}
          </Button>
        </div>
      </Container>
    </Section>

    <!-- Testimonial -->
    <Section
      id="testimonial"
      tone="neutral"
      spacing="md"
      aria-labelledby="testimonialHeading"
    >
      <Container size="lg">
        <h2 id="testimonialHeading" class="text-center text-h2 text-neutral-900">
          {home.testimonialSlice.heading}
        </h2>

        {featuredTestimonial && (
          <Card variant="outlined" padding="lg" class="mt-10 bg-brand-white">
            <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-start">
              <div>
                <StarRating
                  rating={featuredTestimonial.data.rating}
                  size="md"
                  label={home.testimonialSlice.ratingAriaLabel}
                />
                <blockquote class="mt-6 text-h3 text-neutral-900">
                  &ldquo;{featuredTestimonial.data.quote}&rdquo;
                </blockquote>
                <p class="mt-6 text-small text-neutral-700">
                  <span class="font-semibold text-neutral-900">{featuredTestimonial.data.author}</span>
                  {featuredTestimonial.data.location ? ` · ${featuredTestimonial.data.location}` : ''}
                </p>
                <div class="mt-6">
                  <a
                    href={withBase(home.testimonialSlice.readMoreHref)}
                    class="text-small text-primary underline underline-offset-4 hover:text-primary-dark"
                  >
                    {home.testimonialSlice.readMoreLabel}
                  </a>
                </div>
              </div>
              <div class="hidden md:block">
                <img
                  src={withBase(resolvePublicImage(featuredTestimonial.data.avatarPath, 'avatar'))}
                  alt=""
                  width="96"
                  height="96"
                  class="h-24 w-24 rounded-full bg-neutral-50"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </Card>
        )}
      </Container>
    </Section>

    <CTABand
      id="cta"
      tone={home.ctaBand.tone}
      headline={home.ctaBand.heading}
      subheading={home.ctaBand.subheading}
      primaryCta={home.ctaBand.primaryCta}
      callCtaLabel={home.ctaBand.callCtaLabel}
    />
  </main>
</BaseLayout>
