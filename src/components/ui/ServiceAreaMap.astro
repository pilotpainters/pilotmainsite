---
/**
 * ServiceAreaMap — Stylized SVG map of the Chicago metro region.
 *
 * Accepts a `cities` array from frontmatter and renders dots + labels for each
 * city found in the internal coordinate lookup. Cities not in the lookup still
 * appear in the companion city-list grid but are omitted from the SVG.
 *
 * All colors reference Tailwind theme tokens via `currentColor` or CSS classes
 * applied to the SVG's parent. Inline fills use CSS custom-property fallbacks
 * mapped to the theme palette for portability.
 *
 * The SVG is decorative — the city list beside it carries the semantic content.
 */

interface CityInput {
  name: string;
  featured?: boolean;
}

interface Props {
  cities: CityInput[];
}

const { cities } = Astro.props;

interface CityCoord {
  x: number;
  y: number;
}

const cityPositions: Record<string, CityCoord> = {
  'Chicago':            { x: 420, y: 250 },
  'Evanston':           { x: 400, y: 170 },
  'Oak Park':           { x: 360, y: 260 },
  'Schaumburg':         { x: 270, y: 180 },
  'Arlington Heights':  { x: 290, y: 140 },
  'Lake Forest':        { x: 350, y: 70 },
  'Wheaton':            { x: 210, y: 270 },
  'Glen Ellyn':         { x: 230, y: 300 },
  'Downers Grove':      { x: 270, y: 320 },
  'Hinsdale':           { x: 310, y: 310 },
  'Naperville':         { x: 200, y: 350 },
  'Aurora':             { x: 150, y: 380 },
};

const mappedCities = cities
  .map((c) => {
    const pos = cityPositions[c.name];
    if (!pos) return null;
    return { ...c, ...pos };
  })
  .filter(Boolean) as (CityInput & CityCoord)[];
---

<svg
  viewBox="0 0 600 500"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Map of Pilot Painters service area in Chicagoland"
  class="w-full h-auto max-w-[600px]"
>
  {/* Lake Michigan — right edge */}
  <path
    d="M480,0 L600,0 L600,500 L480,500 Q500,400 490,300 Q480,200 500,100 Q510,50 480,0 Z"
    class="fill-primary-light/30 stroke-primary-light"
    stroke-width="1.5"
    fill-opacity="0.35"
  />

  {/* Shoreline accent */}
  <path
    d="M480,0 Q510,50 500,100 Q480,200 490,300 Q500,400 480,500"
    fill="none"
    class="stroke-primary"
    stroke-width="2"
    stroke-linecap="round"
  />

  {/* Metro region body */}
  <path
    d="M100,40 L460,40 Q480,40 480,60 L480,0 Q510,50 500,100 Q480,200 490,300 Q500,400 480,500 L480,460 Q480,480 460,480 L100,480 Q80,480 80,460 L80,60 Q80,40 100,40 Z"
    class="fill-neutral-100 stroke-neutral-300"
    stroke-width="1.5"
    fill-opacity="0.6"
  />

  {/* Grid lines for subtle cartographic texture */}
  {[120, 200, 280, 360, 440].map((x) => (
    <line x1={x} y1="40" x2={x} y2="480" class="stroke-neutral-300" stroke-width="0.5" stroke-dasharray="4,6" opacity="0.4" />
  ))}
  {[120, 200, 280, 360, 440].map((y) => (
    <line x1="80" y1={y} x2="480" y2={y} class="stroke-neutral-300" stroke-width="0.5" stroke-dasharray="4,6" opacity="0.4" />
  ))}

  {/* Non-featured cities (rendered first so featured dots layer on top) */}
  {mappedCities
    .filter((c) => !c.featured)
    .map((c) => (
      <g>
        <circle cx={c.x} cy={c.y} r="4" class="fill-neutral-500" />
        <text
          x={c.x}
          y={c.y - 10}
          text-anchor="middle"
          class="fill-neutral-700"
          font-size="11"
          font-family="Inter, ui-sans-serif, system-ui, sans-serif"
          font-weight="500"
        >
          {c.name}
        </text>
      </g>
    ))}

  {/* Featured cities */}
  {mappedCities
    .filter((c) => c.featured)
    .map((c) => (
      <g>
        <circle cx={c.x} cy={c.y} r="8" class="fill-primary" opacity="0.2" />
        <circle cx={c.x} cy={c.y} r="5" class="fill-primary" />
        <text
          x={c.x}
          y={c.y - 14}
          text-anchor="middle"
          class="fill-neutral-900"
          font-size="13"
          font-family="Inter, ui-sans-serif, system-ui, sans-serif"
          font-weight="600"
        >
          {c.name}
        </text>
      </g>
    ))}

  {/* Label */}
  <text
    x="280"
    y="468"
    text-anchor="middle"
    class="fill-neutral-500"
    font-size="11"
    font-family="Inter, ui-sans-serif, system-ui, sans-serif"
    font-weight="500"
    letter-spacing="0.05em"
  >
    PILOT PAINTERS SERVICE AREA
  </text>
</svg>
