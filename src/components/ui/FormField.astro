---
/**
 * FormField — reusable form field component wrapping label, input/textarea/select,
 * optional help text, and reserved error-message space.
 *
 * Variants:
 * - `input` (default): renders an <input> with the specified `type`.
 * - `textarea`: renders a <textarea> with configurable `rows`.
 * - `select`: renders a <select>; pass options via the default <slot>.
 *
 * All field types share consistent border, padding, focus, and validation styling.
 * Native HTML5 validation is used — :invalid state is styled via peer utilities.
 */

type FieldType = 'input' | 'textarea' | 'select';

interface Props {
  fieldType?: FieldType;
  type?: string;
  name: string;
  id: string;
  label: string;
  placeholder?: string;
  required?: boolean;
  helpText?: string;
  rows?: number;
  pattern?: string;
  class?: string;
}

const {
  fieldType = 'input',
  type = 'text',
  name,
  id,
  label,
  placeholder,
  required = false,
  helpText,
  rows = 5,
  pattern,
  class: className = '',
} = Astro.props;

const helpId = helpText ? `${id}-help` : undefined;
const inputClasses =
  'peer w-full rounded-md border border-neutral-300 bg-brand-white px-4 py-2.5 text-body text-neutral-900 placeholder:text-neutral-500 transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1 focus:ring-offset-brand-white invalid:[&:not(:placeholder-shown):not(:focus)]:border-error invalid:[&:not(:placeholder-shown):not(:focus)]:ring-1 invalid:[&:not(:placeholder-shown):not(:focus)]:ring-error';
---

<div class:list={['space-y-1.5', className]}>
  <label for={id} class="block text-small font-medium text-neutral-900">
    {label}{required && <span class="ml-0.5 text-error" aria-hidden="true">*</span>}
  </label>

  {fieldType === 'textarea' ? (
    <textarea
      name={name}
      id={id}
      rows={rows}
      placeholder={placeholder}
      required={required}
      aria-required={required ? 'true' : undefined}
      aria-describedby={helpId}
      class={inputClasses}
    />
  ) : fieldType === 'select' ? (
    <select
      name={name}
      id={id}
      required={required}
      aria-required={required ? 'true' : undefined}
      aria-describedby={helpId}
      class:list={[inputClasses, 'appearance-none bg-[url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2712%27 height=%2712%27 viewBox=%270 0 12 12%27%3E%3Cpath fill=%27%2364748b%27 d=%27M2 4l4 4 4-4%27/%3E%3C/svg%3E")] bg-[length:12px] bg-[right_12px_center] bg-no-repeat pr-10']}
    >
      <slot />
    </select>
  ) : (
    <input
      type={type}
      name={name}
      id={id}
      placeholder={placeholder}
      required={required}
      aria-required={required ? 'true' : undefined}
      aria-describedby={helpId}
      pattern={pattern}
      class={inputClasses}
    />
  )}

  {helpText && (
    <p id={helpId} class="text-caption text-neutral-500">{helpText}</p>
  )}

  <p class="hidden text-caption text-error peer-invalid:[&:not(:placeholder-shown):not(:focus)]:block" aria-live="polite">
    Please enter a valid {label.toLowerCase()}.
  </p>
</div>
