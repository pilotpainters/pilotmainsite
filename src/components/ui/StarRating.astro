---
/**
 * StarRating — renders 1-5 stars with support for fractional ratings.
 *
 * Uses a layered SVG approach: a gray star background with a colored overlay
 * clipped to the correct fill percentage for each star position.
 *
 * IDs are deterministic (module-level counter) to produce stable build output.
 */

type Size = 'sm' | 'md' | 'lg';

interface Props {
  rating: number;
  size?: Size;
  label?: string;
  class?: string;
  emptyClass?: string;
  filledClass?: string;
}

let counter = 0;

const {
  rating,
  size = 'md',
  label,
  class: className = '',
  emptyClass = 'fill-neutral-300',
  filledClass = 'fill-accent',
} = Astro.props;

const sizeClasses: Record<Size, string> = {
  sm: 'h-4 w-4',
  md: 'h-5 w-5',
  lg: 'h-7 w-7',
};

const ariaLabel = label ?? `Rated ${rating} out of 5 stars`;
const starSize = sizeClasses[size];
const uid = `sr${counter++}`;
---

<div class:list={['inline-flex items-center gap-0.5', className]} role="img" aria-label={ariaLabel}>
  {Array.from({ length: 5 }).map((_, i) => {
    const fillPercent = Math.min(1, Math.max(0, rating - i)) * 100;
    const clipId = `${uid}-${i}`;
    return (
      <svg
        viewBox="0 0 24 24"
        class:list={[starSize, 'shrink-0']}
        aria-hidden="true"
      >
        <defs>
          <clipPath id={clipId}>
            <rect x="0" y="0" width={`${fillPercent}%`} height="100%" />
          </clipPath>
        </defs>
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
          class={emptyClass}
        />
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
          class={filledClass}
          clip-path={`url(#${clipId})`}
        />
      </svg>
    );
  })}
</div>
