---
/**
 * StarRating — renders 1-5 stars with support for fractional ratings.
 *
 * Uses a layered SVG approach: a gray star background with a colored overlay
 * clipped to the correct fill percentage for each star position. This avoids
 * complex SVG masks and works in all modern browsers.
 *
 * Props:
 * - `rating`: number 0-5, supports decimals (e.g. 4.7)
 * - `size`: visual size — sm (16px), md (20px), lg (28px)
 * - `label`: optional custom aria-label; defaults to "Rated X out of 5 stars"
 */

type Size = 'sm' | 'md' | 'lg';

interface Props {
  rating: number;
  size?: Size;
  label?: string;
  class?: string;
}

const { rating, size = 'md', label, class: className = '' } = Astro.props;

const sizeClasses: Record<Size, string> = {
  sm: 'h-4 w-4',
  md: 'h-5 w-5',
  lg: 'h-7 w-7',
};

const ariaLabel = label ?? `Rated ${rating} out of 5 stars`;
const starSize = sizeClasses[size];
const uid = `sr-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['inline-flex items-center gap-0.5', className]} role="img" aria-label={ariaLabel}>
  {Array.from({ length: 5 }).map((_, i) => {
    const starIndex = i + 1;
    const fillPercent = Math.min(1, Math.max(0, rating - i)) * 100;
    const clipId = `${uid}-${i}`;
    return (
      <svg
        viewBox="0 0 24 24"
        class:list={[starSize, 'shrink-0']}
        aria-hidden="true"
      >
        <defs>
          <clipPath id={clipId}>
            <rect x="0" y="0" width={`${fillPercent}%`} height="100%" />
          </clipPath>
        </defs>
        {/* Gray background star */}
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
          class="fill-neutral-300"
        />
        {/* Colored foreground star, clipped to fill percentage */}
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
          class="fill-accent"
          clip-path={`url(#${clipId})`}
        />
      </svg>
    );
  })}
</div>
