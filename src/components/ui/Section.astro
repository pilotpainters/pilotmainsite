---
import Container from '../layout/Container.astro';

interface Props {
  /** Background tone. */
  tone?: 'white' | 'neutral' | 'dark' | 'primary';
  /** Vertical padding scale. */
  spacing?: 'sm' | 'md' | 'lg';
  /** Container size — set to `null` to opt out of the container. */
  containerSize?: 'sm' | 'default' | 'lg' | 'full' | null;
  id?: string;
  class?: string;
  /** Optional id of heading element for `aria-labelledby`. */
  labelledby?: string;
}

const {
  tone = 'white',
  spacing = 'md',
  containerSize = 'default',
  id,
  class: className = '',
  labelledby,
} = Astro.props;

const tones = {
  white: 'bg-brand-white text-neutral-700',
  neutral: 'bg-neutral-50 text-neutral-700',
  dark: 'bg-brand-black text-neutral-100',
  primary: 'bg-primary text-brand-white',
} as const;

const spacings = {
  sm: 'py-12',
  md: 'py-16 md:py-24',
  lg: 'py-24 md:py-32',
} as const;
---

<section id={id} aria-labelledby={labelledby ?? undefined} class:list={[tones[tone], spacings[spacing], className]}>
  {
    containerSize ? (
      <Container size={containerSize}>
        <slot />
      </Container>
    ) : (
      <slot />
    )
  }
</section>
