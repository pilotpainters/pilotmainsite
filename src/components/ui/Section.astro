---
import Container from '../layout/Container.astro';

interface Props {
  tone?: 'white' | 'neutral' | 'dark' | 'primary';
  spacing?: 'sm' | 'md' | 'lg';
  containerSize?: 'sm' | 'default' | 'lg' | 'full' | null;
  id?: string;
  class?: string;
  labelledby?: string;
  'aria-labelledby'?: string;
  'aria-label'?: string;
}

const {
  tone = 'white',
  spacing = 'md',
  containerSize = 'default',
  id,
  class: className = '',
  labelledby,
  'aria-labelledby': ariaLabelledby,
  'aria-label': ariaLabel,
} = Astro.props;

const resolvedLabelledby = labelledby ?? ariaLabelledby;

const tones = {
  white: 'bg-brand-white text-neutral-700',
  neutral: 'bg-neutral-50 text-neutral-700',
  dark: 'bg-brand-black text-neutral-100',
  primary: 'bg-primary text-brand-white',
} as const;

const spacings = {
  sm: 'py-12',
  md: 'py-16 md:py-24',
  lg: 'py-24 md:py-32',
} as const;
---

<section
  id={id}
  aria-labelledby={resolvedLabelledby ?? undefined}
  aria-label={ariaLabel ?? undefined}
  class:list={[tones[tone], spacings[spacing], className]}
>
  {
    containerSize ? (
      <Container size={containerSize}>
        <slot />
      </Container>
    ) : (
      <slot />
    )
  }
</section>
