---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '../layout/Container.astro';
import { Icon } from 'astro-icon/components';
import { withBase } from '@/lib/url';
import { siteConfig } from '@config/site.config';
import { formatFullDate } from '@/lib/dates';
import { marked, Renderer } from 'marked';

interface LegalSection {
  id: string;
  heading: string;
  body: string;
}

interface LegalData {
  seo: {
    title: string;
    description: string;
    noindex?: boolean;
    ogImage?: string;
  };
  hero: {
    eyebrow?: string;
    headline: string;
    subheadline: string;
  };
  lastUpdated: Date;
  effectiveDate: Date;
  legalReviewBanner: {
    enabled: boolean;
    message: string;
  };
  tableOfContents: {
    enabled: boolean;
    heading: string;
  };
  sections: LegalSection[];
  crossLinks?: Array<{ label: string; href: string }>;
}

interface Props {
  legal: LegalData;
}

const { legal } = Astro.props;

const lastUpdatedStr = formatFullDate(legal.lastUpdated);
const effectiveDateStr = formatFullDate(legal.effectiveDate);

const renderer = new Renderer();
const siteOrigin = new URL(siteConfig.seo.siteUrl).origin;
renderer.link = function ({ href, text }) {
  const isExternal = /^https?:\/\//i.test(href) && !href.startsWith(siteOrigin);
  const attrs = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
  return `<a href="${href}"${attrs}>${text}</a>`;
};

marked.setOptions({ breaks: false, gfm: true });

const renderedSections = legal.sections.map((s) => ({
  ...s,
  html: marked.parse(s.body, { renderer }) as string,
}));
---

<BaseLayout
  title={legal.seo.title}
  description={legal.seo.description}
  image={legal.seo.ogImage}
  noindex={legal.seo.noindex}
>
  <main class="flex-1">
    {/* Hero — compact, utility-grade slate background */}
    <Section
      id="legal-hero"
      tone="neutral"
      spacing="sm"
      labelledby="legal-hero-heading"
      class="!py-12 md:!py-16"
    >
      <div class="max-w-3xl">
        {legal.hero.eyebrow && (
          <p class="text-caption uppercase tracking-wide text-primary">{legal.hero.eyebrow}</p>
        )}
        <h1 id="legal-hero-heading" class="mt-3 text-h1 text-neutral-900">
          {legal.hero.headline}
        </h1>
        <p class="mt-4 text-body text-neutral-700">{legal.hero.subheadline}</p>
        <p class="mt-3 text-small text-neutral-500">
          Last updated: {lastUpdatedStr} &middot; Effective: {effectiveDateStr}
        </p>
      </div>
    </Section>

    {/* Legal review banner */}
    {legal.legalReviewBanner.enabled && (
      <section class="bg-warning/10 border-b border-warning/30">
        <Container size="lg">
          <div class="flex gap-4 py-5" role="status">
            <Icon
              name="lucide:alert-triangle"
              class="mt-0.5 h-6 w-6 shrink-0 text-warning"
              aria-hidden="true"
            />
            <div>
              <p class="text-small font-semibold text-neutral-900">
                Placeholder Content &mdash; Lawyer Review Required
              </p>
              <p class="mt-1 text-small text-neutral-700">
                {legal.legalReviewBanner.message}
              </p>
            </div>
          </div>
        </Container>
      </section>
    )}

    {/* Two-column content layout */}
    <Section id="legal-body" tone="white" spacing="md">
      <div class="lg:grid lg:grid-cols-[16rem_1fr] lg:gap-12">
        {/* Sidebar: table of contents */}
        {legal.tableOfContents.enabled && (
          <nav aria-label="Table of Contents" class="mb-10 lg:mb-0">
            <div class="hidden lg:block lg:sticky lg:top-24">
              <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-5">
                <p class="text-caption font-semibold uppercase tracking-wide text-neutral-500">
                  {legal.tableOfContents.heading}
                </p>
                <ol class="mt-4 list-decimal space-y-2 pl-5 text-small">
                  {legal.sections.map((s) => (
                    <li>
                      <a
                        href={`#${s.id}`}
                        class="text-neutral-700 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                      >
                        {s.heading}
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </div>

            <details class="lg:hidden rounded-lg border border-neutral-200 bg-neutral-50">
              <summary class="cursor-pointer p-4 text-small font-semibold text-neutral-700">
                {legal.tableOfContents.heading}
              </summary>
              <ol class="list-decimal space-y-2 px-4 pb-4 pl-9 text-small">
                {legal.sections.map((s) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      class="text-neutral-700 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                    >
                      {s.heading}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )}

        {/* Main content column */}
        <div class="max-w-none space-y-10 lg:max-w-3xl">
          {renderedSections.map((s) => (
            <section id={s.id} aria-labelledby={`${s.id}-heading`} class="scroll-mt-24">
              <h2 id={`${s.id}-heading`} class="text-h3 text-neutral-900">
                {s.heading}
              </h2>
              <div
                class="prose-legal mt-4"
                set:html={s.html}
              />
            </section>
          ))}

          {/* Footer note */}
          <div class="border-t border-neutral-200 pt-8">
            <p class="text-small text-neutral-500">
              If you have questions about this policy, contact us at{' '}
              <a href={`mailto:${siteConfig.email}`} class="text-primary hover:text-primary-dark">
                {siteConfig.email}
              </a>{' '}
              or{' '}
              <a href={`tel:${siteConfig.phoneTel}`} class="text-primary hover:text-primary-dark">
                {siteConfig.phone}
              </a>.
            </p>

            {legal.crossLinks && legal.crossLinks.length > 0 && (
              <p class="mt-4 text-small text-neutral-500">
                See also:{' '}
                {legal.crossLinks.map((link, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a
                      href={withBase(link.href)}
                      class="text-primary hover:text-primary-dark"
                    >
                      {link.label}
                    </a>
                  </>
                ))}
              </p>
            )}
          </div>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
